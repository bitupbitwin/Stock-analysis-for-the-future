# =============================================================================
# Stock Analysis for the Future — 统一配置（唯一事实来源）
# =============================================================================
# 只在这里填一次，hub 的导通层 (hub/envmap.py) 会自动翻译成每个引擎
# 各自认识的变量名。不要去改 engines/*/.env。
#
# 查看某个引擎实际会收到什么：
#   python -m hub envmap --engine daily_stock_analysis
#
# 空值不会被注入，所以用不到的键留空即可。
# =============================================================================

# -----------------------------------------------------------------------------
# 1. LLM API Key —— 至少填一个，否则四个引擎都跑不起来
# -----------------------------------------------------------------------------
# DeepSeek：性价比最高，四个引擎全都支持，只填这一个就能全线跑通（推荐起步）
SAF_DEEPSEEK_API_KEY=
SAF_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# 其余为可选替代
SAF_OPENAI_API_KEY=
SAF_OPENROUTER_API_KEY=
SAF_DASHSCOPE_API_KEY=
SAF_GEMINI_API_KEY=
SAF_ANTHROPIC_API_KEY=
SAF_ZHIPU_API_KEY=
SAF_MINIMAX_API_KEY=
SAF_ANSPIRE_API_KEY=
SAF_AIHUBMIX_KEY=

# -----------------------------------------------------------------------------
# 2. 搜索/新闻源 —— 决定"能不能自动发现政策与技术突破"
# -----------------------------------------------------------------------------
# 全部留空时 daily_stock_analysis 会退回免费源（SearXNG 公共实例），
# 能跑但会限流、不稳定。想让新闻发现真正可靠，至少配一个。
SAF_TAVILY_API_KEY=
SAF_SERPAPI_API_KEY=
SAF_BRAVE_API_KEY=
SAF_SEARXNG_BASE_URL=
SAF_JINA_API_KEY=

# -----------------------------------------------------------------------------
# 3. 行情数据 —— 留空则用 akshare 免费源（够用，但有频率限制）
# -----------------------------------------------------------------------------
SAF_TUSHARE_TOKEN=
SAF_FINNHUB_API_KEY=
SAF_ALPHAVANTAGE_API_KEY=

# -----------------------------------------------------------------------------
# 4. 自选股与评估口径
# -----------------------------------------------------------------------------
# 6 位代码，逗号分隔
SAF_WATCHLIST=600519,300750,002594

# 命中率的基准指数（默认沪深300）
SAF_BENCHMARK=000300

# 中性带：涨跌幅绝对值小于该值算"震荡"。调大 = 判定更严格。
SAF_NEUTRAL_BAND_PCT=2.0

# -----------------------------------------------------------------------------
# 5. 结果推送（可选）
# -----------------------------------------------------------------------------
SAF_WECOM_WEBHOOK=
SAF_DINGTALK_WEBHOOK=
SAF_FEISHU_WEBHOOK=

# =============================================================================
# 安全提示
# =============================================================================
# aiagents-stock 预留了 MiniQMT 自动交易接口。hub 会强制注入
# MINIQMT_ENABLED=false。在你自己完成足够长的样本外验证之前，不要打开它。
# =============================================================================
